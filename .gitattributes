# Normalise line endings so the repo stays consistent across platforms
* text=auto eol=lf

# Binary-ish assets — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Keep SVG and source maps as text so diffs stay readable
*.svg text
*.map text
